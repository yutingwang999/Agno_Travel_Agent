# PostgreSQL connection settings — must match docker-compose.yml
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=travel_agent_password
POSTGRES_DB=travel_agent_db
POSTGRES_PORT=5432

# Full DSN used by SQLAlchemy and Alembic, built from the values above
# (python-dotenv and docker compose both expand ${VAR} references).
# If the password contains URL-special characters (@ : / ? # %), write the URL out
# with the password percent-encoded instead.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Separate database for integration and destructive (migration) tests, in the same
# Postgres container. pytest replaces DATABASE_URL with this value, so tests never
# touch the development database. The database name MUST end with "_test_db"
# (the migration tests refuse to downgrade anything else).
# Create, migrate and seed it with: python scripts/dev.py test-db-setup
# If unset, integration and destructive tests are skipped.
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/travel_agent_test_db

# Gemini API key — required for LLM generation (generate step) and embedding (cag_match, seed)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for text generation in the generate step
LLM_MODEL=gemini-2.5-flash-lite

# Embedding model used for itinerary_categories and source_documents vectors
# Must be the same model used in both seed.py and cag_match step
EMBEDDING_MODEL=gemini-embedding-001

# Uvicorn host and port for local development
APP_HOST=0.0.0.0
APP_PORT=8000
